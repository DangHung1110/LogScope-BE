{
  "name": "api",
  "version": "0.1.0",
  "description": "LogScope public API service",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "pnpm build:deps && nest build",
    "build:deps": "pnpm --filter @logscope/config build && pnpm --filter @logscope/contracts build && pnpm --filter @logscope/database build && pnpm --filter @logscope/elasticsearch build && pnpm --filter @logscope/http build && pnpm --filter @logscope/shared build",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "start": "nest start",
    "start:dev": "pnpm build:deps && nest start --watch",
    "start:debug": "pnpm build:deps && nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm build:deps && tsc --noEmit",
    "test": "pnpm build:deps && jest",
    "test:watch": "jest --watch",
    "test:cov": "pnpm build:deps && jest --coverage",
    "test:ci": "pnpm build:deps && jest --runInBand --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register ../../node_modules/.bin/jest --runInBand",
    "test:e2e": "pnpm build:deps && jest --config ./test/jest-e2e.json --runInBand"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@as-integrations/express5": "^1.1.2",
    "@logscope/config": "workspace:*",
    "@logscope/contracts": "workspace:*",
    "@logscope/database": "workspace:*",
    "@logscope/elasticsearch": "workspace:*",
    "@logscope/http": "workspace:*",
    "@logscope/shared": "workspace:*",
    "@nestjs/apollo": "^13.4.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/graphql": "^13.4.2",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.2.1",
    "graphql": "^16.11.0",
    "graphql-subscriptions": "^3.0.0",
    "graphql-type-json": "^0.3.2",
    "redis": "^6.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ts-morph": "^28.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../../coverage/apps/api",
    "testEnvironment": "node"
  }
}
