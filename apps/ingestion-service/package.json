{
  "name": "ingestion-service",
  "version": "0.1.0",
  "description": "LogScope log ingestion service",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "pnpm build:deps && tsc -p tsconfig.json",
    "build:deps": "pnpm --filter @logscope/config build && pnpm --filter @logscope/contracts build && pnpm --filter @logscope/database build && pnpm --filter @logscope/http build && pnpm --filter @logscope/kafka build && pnpm --filter @logscope/shared build",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "start:dev": "pnpm build:deps && ts-node --transpile-only src/main.ts",
    "test": "pnpm build:deps && jest",
    "test:ci": "pnpm test -- --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@logscope/config": "workspace:*",
    "@logscope/contracts": "workspace:*",
    "@logscope/database": "workspace:*",
    "@logscope/http": "workspace:*",
    "@logscope/kafka": "workspace:*",
    "@logscope/shared": "workspace:*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.1.13"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../../coverage/apps/ingestion-service",
    "testEnvironment": "node"
  }
}
